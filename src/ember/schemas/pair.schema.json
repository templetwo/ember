{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember:pair:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "source_kind",
    "source_claim_ids",
    "recorded_at",
    "shape",
    "pair_class",
    "holdout",
    "situation",
    "evidence",
    "target",
    "review",
    "recorded_at_precision"
  ],
  "properties": {
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "const": "temple_record"
    },
    "source_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "shape": {
      "enum": [
        "catch",
        "judged_gate",
        "close",
        "supersession",
        "ruling",
        "open_thread"
      ]
    },
    "pair_class": {
      "enum": [
        "observed-decision",
        "retrospective-rule"
      ]
    },
    "holdout": {
      "enum": [
        "none",
        "robot_stop"
      ]
    },
    "situation": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "recorded_at",
          "text",
          "source_row_id"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_row_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "target": {
      "$ref": "urn:ember:decision:0.1"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader",
        "receipt",
        "label_source_claim_id",
        "observed_act",
        "negations_checked",
        "unverified_claims_tagged",
        "label_source_row_id"
      ],
      "properties": {
        "reader": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "label_source_claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_act": {
          "enum": [
            "proceed",
            "stop"
          ]
        },
        "negations_checked": {
          "const": true
        },
        "unverified_claims_tagged": {
          "const": true
        },
        "label_source_row_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_time_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_claim_id",
            "end_claim_id",
            "end_at"
          ],
          "properties": {
            "start_claim_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "end_claim_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "end_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "event_date_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "recorded_at_precision": {
      "enum": [
        "clock",
        "day",
        "bounded-by-records"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recorded_at_precision": {
            "const": "bounded-by-records"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "decision_time_bounds"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "review": {
            "not": {
              "required": [
                "decision_time_bounds"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recorded_at_precision": {
            "const": "day"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "event_date",
              "event_date_claim_ids"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "review": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "event_date"
                  ]
                },
                {
                  "required": [
                    "event_date_claim_ids"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
