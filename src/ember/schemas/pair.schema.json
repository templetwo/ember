{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember:pair:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pair_id", "source_kind", "source_claim_ids", "recorded_at", "shape", "pair_class", "holdout", "situation", "evidence", "target", "review"],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "source_kind": {"const": "temple_record"},
    "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "shape": {"enum": ["catch", "judged_gate", "close", "supersession", "ruling", "open_thread"]},
    "pair_class": {"enum": ["observed-stop", "retrospective-rule", "over-stop"]},
    "holdout": {"enum": ["none", "robot_stop"]},
    "situation": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "recorded_at", "text"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "recorded_at": {"type": "string", "format": "date-time"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "target": {"$ref": "urn:ember:decision:0.1"},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reader", "receipt", "label_source_claim_id", "negations_checked", "unverified_claims_tagged"],
      "properties": {
        "reader": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "minLength": 1},
        "label_source_claim_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "negations_checked": {"const": true},
        "unverified_claims_tagged": {"const": true}
      }
    }
  }
}
