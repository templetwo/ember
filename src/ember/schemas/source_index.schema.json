{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember:source_index:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rows",
    "stakes_screen_version"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chronology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reader": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_row_id",
          "claim_id",
          "source_utc",
          "record_sha256",
          "timestamp_basis",
          "seed_backfill",
          "review_holds"
        ],
        "properties": {
          "source_row_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "source_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "timestamp_basis": {
            "enum": [
              "explicit-source-offset",
              "HQ-v2-writer-and-file-clock-evidence; zoneinfo-recomputed",
              "unresolved-vault-import"
            ]
          },
          "seed_backfill": {
            "type": "boolean"
          },
          "review_holds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_day_review": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "urn:ember:date_review:0.1"
                  },
                  {
                    "properties": {
                      "status": {
                        "const": "attested"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "attesting_seat": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prepared_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stakes_screen_version": {
      "const": "explicit-references-v1"
    }
  }
}
